diff --git a/src/AlFariq.UI/Components/MatchCancellation.razor b/src/AlFariq.UI/Components/MatchCancellation.razor
new file mode 100644
index 0000000..1cb2a2c
--- /dev/null
+++ b/src/AlFariq.UI/Components/MatchCancellation.razor
@@ -0,0 +1,90 @@
+@using AlFariq.Application
+@inject IStringLocalizer<Strings> L
+@inject MatchService Service
+
+@* Annuler un match planifié, avec un motif facultatif, ou rétablir un match annulé (US-012). *@
+@if (Match.Status == MatchStatus.Planned)
+{
+    if (!_confirming)
+    {
+        <button type="button" class="button button--ghost button--danger" @onclick="() => _confirming = true">
+            @L["Cancel_Match"]
+        </button>
+    }
+    else
+    {
+        <div class="card">
+            <p>@L["Cancel_Explain"]</p>
+            <div class="field">
+                <label for="cancel-reason">@L["Cancel_Reason"]</label>
+                <input id="cancel-reason" type="text" dir="auto" autocomplete="off" enterkeyhint="done"
+                       maxlength="@Match.MaxCancellationReasonLength" @bind="_reason" @bind:event="oninput" />
+            </div>
+            <div class="actions">
+                <button type="button" class="button button--ghost button--danger" disabled="@_saving" @onclick="CancelAsync">
+                    @L["Cancel_Confirm"]
+                </button>
+                <button type="button" class="button button--ghost" disabled="@_saving" @onclick="Close">
+                    @L["Cancel_Keep"]
+                </button>
+            </div>
+        </div>
+    }
+}
+else if (Match.Status == MatchStatus.Cancelled)
+{
+    <button type="button" class="button" disabled="@_saving" @onclick="ReinstateAsync">@L["Cancel_Restore"]</button>
+}
+
+@if (_failed)
+{
+    <p class="field__error" role="alert">@L["Result_SaveFailed"]</p>
+}
+
+@code {
+    private bool _confirming;
+    private bool _saving;
+    private bool _failed;
+    private string _reason = "";
+
+    [Parameter, EditorRequired] public Match Match { get; set; } = default!;
+
+    /// <summary>L'état du match a changé : la page se recharge.</summary>
+    [Parameter] public EventCallback OnChanged { get; set; }
+
+    private void Close()
+    {
+        _confirming = _failed = false;
+        _reason = "";
+    }
+
+    private Task CancelAsync() => SaveAsync(() => Service.CancelAsync(Match.Id, _reason));
+
+    private Task ReinstateAsync() => SaveAsync(() => Service.ReinstateAsync(Match.Id));
+
+    private async Task SaveAsync(Func<Task> write)
+    {
+        if (_saving)
+        {
+            return;
+        }
+
+        _saving = true;
+        _failed = false;
+        try
+        {
+            await write();
+            Close();
+            await OnChanged.InvokeAsync();
+        }
+        catch (Exception exception)
+        {
+            Console.Error.WriteLine(exception);
+            _failed = true;
+        }
+        finally
+        {
+            _saving = false;
+        }
+    }
+}
diff --git a/src/AlFariq.UI/Components/MatchResultCard.razor b/src/AlFariq.UI/Components/MatchResultCard.razor
new file mode 100644
index 0000000..e1a6c69
--- /dev/null
+++ b/src/AlFariq.UI/Components/MatchResultCard.razor
@@ -0,0 +1,100 @@
+@using AlFariq.Application
+@inject IStringLocalizer<Strings> L
+@inject TimeProvider Clock
+
+@* Le résultat sur la fiche d'un match (US-012) : le score et les buteurs, ou l'accès à la saisie. *@
+<div class="card">
+    <h2>@L["Result_Title"]</h2>
+    @if (Sheet.Score is { } score)
+    {
+        TeamLineup[] teams = [Sheet.Lineup.TeamA, Sheet.Lineup.TeamB];
+
+        <div class="scoreboard">
+            @foreach (var team in teams)
+            {
+                <div @key="team.Side" class="scoreboard__team team-color--@team.ColorCode">
+                    <p class="team-heading">
+                        <span class="team-dot" aria-hidden="true"></span>
+                        <span class="team-heading__name" dir="auto">@Name(team)</span>
+                    </p>
+                    <p class="scoreboard__score">@score.For(team.Side)</p>
+                </div>
+            }
+        </div>
+        <p class="scoreboard__outcome user-text">
+            @(score.Winner is { } winner ? L["Result_Winner", Name(Sheet.Lineup.Team(winner))] : L["Result_Draw"])
+        </p>
+
+        if (Sheet.Players.Count > 0)
+        {
+            <h3 class="scorers__title">@L["Result_ScorersTitle"]</h3>
+            foreach (var team in teams)
+            {
+                var cited = team.Players.Where(player => Sheet.Players.ContainsKey(player.Id))
+                    .OrderByDescending(player => Sheet.Players[player.Id].Goals)
+                    .ToList();
+                if (cited.Count > 0)
+                {
+                    <div @key="team.Side" class="team-color--@team.ColorCode">
+                        <p class="team-heading">
+                            <span class="team-dot" aria-hidden="true"></span>
+                            <span class="team-heading__name" dir="auto">@Name(team)</span>
+                        </p>
+                        <ul class="squad-names scorers__list">
+                            @foreach (var player in cited)
+                            {
+                                <li @key="player.Id">
+                                    <span dir="auto">@player.Name</span>
+                                    <span class="hint">@Describe(Sheet.Players[player.Id])</span>
+                                </li>
+                            }
+                        </ul>
+                    </div>
+                }
+            }
+        }
+
+        foreach (var team in teams)
+        {
+            <GoalMismatch @key="team.Side" Score="score" Side="team.Side" TeamName="@Name(team)"
+                          PlayerGoals="Sheet.PlayerGoals(team.Side)" />
+        }
+
+        var updated = MatchSchedule.ToLocal(Sheet.Match.UpdatedAt, Clock.LocalTimeZone);
+        <p class="hint">@L["Result_Updated", MatchLabels.LongDate(updated), MatchLabels.Time(updated)]</p>
+        <div class="actions">
+            <a class="button button--ghost" href="matchs/@Sheet.Match.Id/resultat">@L["Result_Edit"]</a>
+        </div>
+    }
+    else
+    {
+        <p class="hint">@L["Result_NotEntered"]</p>
+        @* Bouton principal une fois le match commencé : c'est alors l'action attendue. *@
+        <div class="actions">
+            <a class="button @(Sheet.Match.StartsAt <= Clock.GetUtcNow() ? "" : "button--ghost")"
+               href="matchs/@Sheet.Match.Id/resultat">@L["Result_Enter"]</a>
+        </div>
+    }
+</div>
+
+@code {
+    [Parameter, EditorRequired] public MatchSheet Sheet { get; set; } = default!;
+
+    private string Name(TeamLineup team) => TeamLabels.Name(L, team.Side, team.Name);
+
+    private string Describe(PlayerTally tally)
+    {
+        var parts = new List<string>();
+        if (tally.Goals > 0)
+        {
+            parts.Add(tally.Goals > 1 ? L["Result_GoalsCount", tally.Goals] : L["Result_GoalsCountOne"]);
+        }
+
+        if (tally.Assists > 0)
+        {
+            parts.Add(tally.Assists > 1 ? L["Result_AssistsCount", tally.Assists] : L["Result_AssistsCountOne"]);
+        }
+
+        return string.Join(" · ", parts);
+    }
+}
