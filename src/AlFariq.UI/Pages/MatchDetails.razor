@page "/matchs/{Id:guid}"
@using AlFariq.Application
@inject IStringLocalizer<Strings> L
@inject MatchService Service
@inject ResultService Results
@inject TimeProvider Clock
@inject NavigationManager Navigation

<PageTitle>@L["Match_Title"] · @L["App_Name"]</PageTitle>

<section class="page">
    <h1>@L["Match_Title"]</h1>

    @if (_loadFailed)
    {
        <div class="card" role="alert">
            <p>@L["Storage_Unavailable"]</p>
        </div>
    }
    else if (_notFound)
    {
        <div class="card card--empty">
            <p>@L["Match_NotFound"]</p>
        </div>
    }
    else if (_match is not null)
    {
        var start = MatchSchedule.ToLocal(_match.StartsAt, Clock.LocalTimeZone);

        <article class="card">
            <p class="next-match__date">@L["Home_MatchDate", MatchLabels.LongDate(start), MatchLabels.Time(start)]</p>
            <p>
                <span class="badge @(_match.Status == MatchStatus.Cancelled ? "badge--cancelled" : "")">
                    @L[MatchLabels.StatusKey(_match.Status)]
                </span>
            </p>
            @if (_match.CancellationReason is not null)
            {
                <p class="user-text" dir="auto">@L["Cancel_ReasonValue", _match.CancellationReason]</p>
            }
            <dl class="facts">
                <dt>@L["Match_Sport"]</dt>
                <dd>@L[SportLabels.SportKey(_match.SportCode)]</dd>
                <dt>@L["Match_Format"]</dt>
                <dd>@L["Home_MatchFormat", _match.PlayersPerSide]</dd>
                <dt>@L["Match_Duration"]</dt>
                <dd>@L["Match_DurationValue", _match.DurationMinutes]</dd>
                @if (_match.Location is not null)
                {
                    <dt>@L["Match_LocationLabel"]</dt>
                    <dd class="user-text" dir="auto">@_match.Location</dd>
                }
                @if (_match.Notes is not null)
                {
                    <dt>@L["Match_NotesLabel"]</dt>
                    <dd class="user-text" dir="auto">@_match.Notes</dd>
                }
            </dl>
        </article>

        if (_match.Status != MatchStatus.Cancelled)
        {
            <MatchResultCard Sheet="_sheet!" />
        }

        var lineup = _sheet!.Lineup;
        var assigned = lineup.TeamA.Players.Count + lineup.TeamB.Players.Count;

        <div class="card">
            <h2>@L["Squad_Title"]</h2>
            <SquadCount Count="lineup.PlayerCount" Expected="_match.ExpectedPlayers" />
            @* Une fois les équipes commencées, les noms figurent dans la carte « Équipes ». *@
            @if (assigned == 0 && lineup.PlayerCount > 0)
            {
                <ul class="squad-names">
                    @foreach (var player in lineup.Unassigned)
                    {
                        <li @key="player.Id">
                            <span dir="auto">@player.Name</span>
                            @if (player.ProfileId is not null)
                            {
                                <span class="badge">@L["Players_Me"]</span>
                            }
                            @if (player.IsArchived)
                            {
                                <span class="badge">@L["Squad_Archived"]</span>
                            }
                        </li>
                    }
                </ul>
            }
            <div class="actions">
                <a class="button @(lineup.PlayerCount == 0 ? "" : "button--ghost")" href="matchs/@_match.Id/joueurs">@L["Squad_Choose"]</a>
            </div>
        </div>

        if (lineup.PlayerCount > 0)
        {
            <div class="card">
                <h2>@L["Teams_Title"]</h2>
                @if (assigned > 0)
                {
                    <div class="team-columns">
                        @foreach (var team in new[] { lineup.TeamA, lineup.TeamB })
                        {
                            <div @key="team.Side">
                                <h3 class="team-heading team-color--@team.ColorCode">
                                    <span class="team-dot" aria-hidden="true"></span>
                                    <span class="team-heading__name" dir="auto">@TeamLabels.Name(L, team.Side, team.Name)</span>
                                </h3>
                                <p class="hint">@L["Teams_Count", team.Players.Count]</p>
                                <ul class="squad-names">
                                    @foreach (var player in team.Players)
                                    {
                                        <li @key="player.Id"><span dir="auto">@player.Name</span></li>
                                    }
                                </ul>
                            </div>
                        }
                    </div>
                    if (lineup.Unassigned.Count > 0)
                    {
                        <p class="hint user-text">
                            @L["Teams_UnassignedList", string.Join(", ", lineup.Unassigned.Select(player => player.Name))]
                        </p>
                    }
                }
                <div class="actions">
                    <a class="button" href="matchs/@_match.Id/equipes">@L["Teams_Compose"]</a>
                    <a class="button button--ghost" href="matchs/@_match.Id/equipes/terrain">@L["Pitch_Open"]</a>
                    <a class="button button--ghost" href="matchs/@_match.Id/partage">@L["Share_Open"]</a>
                </div>
            </div>
        }

        <div class="actions">
            <a class="button button--ghost" href="matchs/@_match.Id/modifier">@L["Match_Edit"]</a>
            <a class="button button--ghost" href="matchs/@_match.Id/dupliquer">@L["Match_Duplicate"]</a>
            <MatchCancellation Match="_match" OnChanged="ReloadAsync" />
            @if (!_confirmingDeletion)
            {
                <button type="button" class="button button--ghost button--danger" @onclick="() => _confirmingDeletion = true">
                    @L["Match_Delete"]
                </button>
            }
        </div>

        if (_confirmingDeletion)
        {
            <div class="card" role="alert">
                <p>@L["Match_DeleteConfirm"]</p>
                <div class="actions">
                    <button type="button" class="button button--ghost button--danger" disabled="@_deleting" @onclick="DeleteAsync">
                        @L["Match_DeleteYes"]
                    </button>
                    <button type="button" class="button button--ghost" disabled="@_deleting" @onclick="() => _confirmingDeletion = false">
                        @L["Match_Cancel"]
                    </button>
                </div>
            </div>
        }

        if (_deleteFailed)
        {
            <p class="field__error" role="alert">@L["Match_DeleteFailed"]</p>
        }
    }

    <div class="actions">
        <a class="button button--ghost" href="matchs">@L["Match_Back"]</a>
    </div>
</section>

@code {
    private Match? _match;
    private MatchSheet? _sheet;
    private Guid _loadedId;
    private bool _loadFailed;
    private bool _notFound;
    private bool _confirmingDeletion;
    private bool _deleting;
    private bool _deleteFailed;

    [Parameter] public Guid Id { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId == Id)
        {
            return;
        }

        _loadedId = Id;
        _match = null;
        _sheet = null;
        _loadFailed = _notFound = _confirmingDeletion = _deleteFailed = false;

        await ReloadAsync();
    }

    /// <summary>Lit le match, au premier affichage et après une annulation ou un rétablissement.</summary>
    private async Task ReloadAsync()
    {
        try
        {
            _sheet = await Results.GetAsync(Id);
            _match = _sheet?.Match;
            _notFound = _sheet is null;
        }
        catch (Exception exception)
        {
            Console.Error.WriteLine(exception);
            _loadFailed = true;
        }
    }

    private async Task DeleteAsync()
    {
        if (_deleting)
        {
            return;
        }

        _deleting = true;
        _deleteFailed = false;
        try
        {
            await Service.DeleteAsync(Id);
            Navigation.NavigateTo("matchs", replace: true);
        }
        catch (Exception exception)
        {
            Console.Error.WriteLine(exception);
            _deleteFailed = true;
        }
        finally
        {
            _deleting = false;
        }
    }
}
