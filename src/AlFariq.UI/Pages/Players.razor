@page "/joueurs"
@using AlFariq.Application
@inject IStringLocalizer<Strings> L
@inject IRepository<Player> PlayerRepository

<PageTitle>@L["Players_Title"] · @L["App_Name"]</PageTitle>

@* Liste en lecture seule ; l'ajout, la recherche et l'archivage arrivent avec US-005. *@
<section class="page">
    <h1>@L["Players_Title"]</h1>

    @if (_loadFailed)
    {
        <div class="card" role="alert">
            <p>@L["Storage_Unavailable"]</p>
        </div>
    }
    else if (_players is not null)
    {
        if (_players.Count == 0)
        {
            <div class="card">
                <p>@L["Players_Empty"]</p>
                <a class="button button--small button--ghost" href="profil">@L["Profile_Create"]</a>
            </div>
        }
        else
        {
            <ul class="card player-list">
                @foreach (var player in _players)
                {
                    <li @key="player.Id">
                        <span class="player-list__name" dir="auto">@player.Name</span>
                        @if (player.ProfileId is not null)
                        {
                            <span class="badge">@L["Players_Me"]</span>
                        }
                        @if (player.PreferredPositionCode is { } position)
                        {
                            <span class="player-list__position">@L[SportLabels.PositionKey(position)]</span>
                        }
                    </li>
                }
            </ul>
        }

        <p class="hint">@L["Players_ComingSoon"]</p>
    }
</section>

@code {
    private IReadOnlyList<Player>? _players;
    private bool _loadFailed;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _players = await PlayerRepository.ListAsync();
        }
        catch (Exception exception)
        {
            Console.Error.WriteLine(exception);
            _loadFailed = true;
        }
    }
}
