@page "/matchs"
@using System.Globalization
@using AlFariq.Application
@inject IStringLocalizer<Strings> L
@inject MatchHistoryService History
@inject MatchListState State
@inject TimeProvider Clock

<PageTitle>@L["Matches_Title"] · @L["App_Name"]</PageTitle>

<section class="page">
    <h1>@L["Matches_Title"]</h1>

    @if (_loadFailed)
    {
        <div class="card" role="alert">
            <p>@L["Storage_Unavailable"]</p>
        </div>
    }
    else if (_records is not null)
    {
        <div class="actions">
            <a class="button" href="matchs/nouveau">@L["Home_CreateMatch"]</a>
        </div>

        if (_records.Count == 0)
        {
            <div class="card card--empty">
                <p>@L["Matches_Empty"]</p>
            </div>
        }
        else
        {
            var now = Clock.GetUtcNow();
            var criteria = State.Criteria;
            var found = MatchSearch.Find(_records, criteria, Clock.LocalTimeZone);
            var namedPlayers = found.ToDictionary(result => result.Match.Id, result => result.NamedPlayers);
            var matches = found.Select(result => result.Match).ToList();
            var upcoming = MatchSchedule.Upcoming(matches, now);
            var past = MatchSchedule.Past(matches, now);
            var tab = State.ShowPast ? past : upcoming;
            var otherTab = State.ShowPast ? upcoming : past;
            var statuses = MatchSearch.Statuses(tab);
            // Un statut absent de la liste (après une nouvelle recherche) ne filtre pas.
            MatchStatus? status = State.Status is { } chosen && statuses.Contains(chosen) ? chosen : null;
            var visible = MatchSearch.WithStatus(tab, status);

            <div class="match-search" role="search">
                <div class="field">
                    <label for="match-search-player">@L["Matches_SearchPlayer"]</label>
                    <input id="match-search-player" type="search" dir="auto" autocomplete="off" enterkeyhint="search"
                           @bind="State.PlayerName" @bind:event="oninput" />
                </div>
                <div class="field">
                    <label for="match-search-date">@L["Matches_SearchDate"]</label>
                    <input id="match-search-date" type="date" value="@IsoDate(State.Date)" @onchange="SetDate" />
                </div>
            </div>
            if (!criteria.IsEmpty)
            {
                <div class="actions">
                    <button type="button" class="button button--ghost" @onclick="State.ClearSearch">
                        @L["Matches_ClearSearch"]
                    </button>
                </div>
            }
            <p class="sr-only" role="status">
                @(criteria.IsEmpty ? "" : L["Matches_Found", upcoming.Count, past.Count].Value)
            </p>

            <fieldset class="segmented list-filter">
                <legend class="sr-only">@L["Matches_Filter"]</legend>
                <label class="segmented__option">
                    <input type="radio" name="matches-period" checked="@(!State.ShowPast)"
                           @onchange="() => State.Show(past: false)" />
                    <span>@L["Matches_Upcoming", upcoming.Count]</span>
                </label>
                <label class="segmented__option">
                    <input type="radio" name="matches-period" checked="@State.ShowPast"
                           @onchange="() => State.Show(past: true)" />
                    <span>@L["Matches_Past", past.Count]</span>
                </label>
            </fieldset>

            if (statuses.Count > 1)
            {
                <div class="chips match-statuses" role="group" aria-label="@L["Matches_StatusFilter"]">
                    <button type="button" class="chip" aria-pressed="@(status is null ? "true" : "false")"
                            @onclick="() => State.Status = null">
                        @L["Matches_AllStatuses"]
                    </button>
                    @foreach (var choice in statuses)
                    {
                        <button @key="choice" type="button" class="chip"
                                aria-pressed="@(status == choice ? "true" : "false")"
                                @onclick="() => State.Status = choice">
                            @L[MatchLabels.StatusKey(choice)]
                        </button>
                    }
                </div>
            }

            if (visible.Count == 0)
            {
                <p class="hint list-none" role="status">
                    @(!criteria.IsEmpty ? L["Matches_NoResult"]
                        : State.ShowPast ? L["Matches_NoPast"]
                        : L["Matches_NoUpcoming"])
                </p>
                @* La recherche porte sur les deux onglets : on mène droit à celui qui a des résultats. *@
                if (!criteria.IsEmpty && otherTab.Count > 0)
                {
                    <div class="actions">
                        <button type="button" class="button button--ghost"
                                @onclick="() => State.Show(past: !State.ShowPast)">
                            @(State.ShowPast
                                ? L["Matches_ShowUpcoming", otherTab.Count]
                                : L["Matches_ShowPast", otherTab.Count])
                        </button>
                    </div>
                }
            }
            else
            {
                <ul class="card match-list">
                    @foreach (var match in visible)
                    {
                        var start = MatchSchedule.ToLocal(match.StartsAt, Clock.LocalTimeZone);
                        var named = namedPlayers[match.Id];
                        <li @key="match.Id">
                            <a class="match-list__link" href="matchs/@match.Id">
                                <span class="match-list__date">@L["Home_MatchDate", MatchLabels.LongDate(start), MatchLabels.Time(start)]</span>
                                @if (match.Status != MatchStatus.Planned)
                                {
                                    <span class="match-list__status">
                                        <span class="badge @(match.Status == MatchStatus.Cancelled ? "badge--cancelled" : "")">
                                            @L[MatchLabels.StatusKey(match.Status)]
                                        </span>
                                    </span>
                                }
                                <span class="match-list__details">@L[SportLabels.SportKey(match.SportCode)] · @L["Home_MatchFormat", match.PlayersPerSide]</span>
                                @if (match.Location is not null)
                                {
                                    <span class="match-list__details" dir="auto">@match.Location</span>
                                }
                                @if (named.Count > 0)
                                {
                                    <span class="match-list__details">
                                        @L["Matches_WithPlayers", string.Join(", ", named.Select(player => player.Name))]
                                    </span>
                                }
                            </a>
                        </li>
                    }
                </ul>
            }
        }
    }
</section>

@code {
    private IReadOnlyList<MatchRecord>? _records;
    private bool _loadFailed;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _records = await History.ListAsync();
        }
        catch (Exception exception)
        {
            Console.Error.WriteLine(exception);
            _loadFailed = true;
        }
    }

    private static string IsoDate(DateOnly? date) =>
        date?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) ?? "";

    // Un champ date vidé ou incomplet donne un texte vide : le critère disparaît.
    private void SetDate(ChangeEventArgs e) =>
        State.Date = DateOnly.TryParseExact(
            e.Value as string, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var date)
            ? date
            : null;
}
