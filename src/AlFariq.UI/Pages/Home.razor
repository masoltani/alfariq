@page "/"
@using AlFariq.Application
@inject IStringLocalizer<Strings> L
@inject IUpcomingMatchQuery UpcomingMatches
@inject ProfileService Profiles

<PageTitle>@L["App_Name"]</PageTitle>

<section class="page">
    <h1>@(_profile is null ? L["Home_Welcome"] : L["Home_Greeting", _profile.Nickname])</h1>

    @* Rien tant que la lecture n'est pas finie : l'état vide ne doit pas apparaître puis disparaître. *@
    @if (_loaded)
    {
        if (_profileMissing)
        {
            <div class="card">
                <h2>@L["Home_ProfileTitle"]</h2>
                <p>@L["Home_ProfileHint"]</p>
                <a class="button button--small button--ghost" href="profil">@L["Profile_Create"]</a>
            </div>
        }

        if (_nextMatch is not null)
        {
            <NextMatchCard Match="_nextMatch" />
        }
        else
        {
            <div class="card">
                <h2>@L["Home_EmptyTitle"]</h2>
                <p>@L["Home_EmptyGuide"]</p>
                <ol class="steps">
                    <li>@L["Home_StepPlayers"]</li>
                    <li>@L["Home_StepMatch"]</li>
                    <li>@L["Home_StepTeams"]</li>
                </ol>
                <p class="hint">@L["Home_EmptyHint"]</p>
            </div>
        }
    }

    <div class="actions">
        <a class="button" href="matchs/nouveau">@L["Home_CreateMatch"]</a>
        <a class="button button--ghost" href="joueurs">@L["Home_Players"]</a>
        <a class="button button--ghost" href="statistiques">@L["Stats_Title"]</a>
    </div>
</section>

@code {
    private UpcomingMatch? _nextMatch;
    private Profile? _profile;
    private bool _profileMissing;
    private bool _loaded;

    protected override async Task OnInitializedAsync()
    {
        await LoadProfileAsync();
        await LoadNextMatchAsync();
        _loaded = true;
    }

    private async Task LoadNextMatchAsync()
    {
        try
        {
            _nextMatch = await UpcomingMatches.GetNextAsync();
        }
        catch (Exception exception)
        {
            // L'accueil reste utilisable ; l'écran des matchs explique le problème.
            Console.Error.WriteLine(exception);
        }
    }

    private async Task LoadProfileAsync()
    {
        try
        {
            _profile = await Profiles.GetAsync();
            _profileMissing = _profile is null;
        }
        catch (Exception exception)
        {
            // L'accueil reste utilisable ; l'écran du profil explique le problème.
            Console.Error.WriteLine(exception);
        }
    }
}
