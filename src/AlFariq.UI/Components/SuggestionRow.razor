@inject IStringLocalizer<Strings> L

@* Un joueur de la proposition et ses deux verrous : un tap impose l'équipe, un tap sur le verrou actif le retire. *@
<li class="lineup__player">
    <span class="lineup__identity">
        <span class="player-list__name" dir="auto">@Player.Name</span>
        @if (Player.ProfileId is not null)
        {
            <span class="badge">@L["Players_Me"]</span>
        }
        <span class="lineup__details">
            @if (Player.PreferredPositionCode is { } position)
            {
                <span>@L[SportLabels.PositionKey(position)]</span>
            }
            @if (Player.Level is { } level)
            {
                <span>@L["Players_LevelShort", level]</span>
            }
            else
            {
                <span class="suggest-default">@L["Suggest_LevelDefault", TeamBalancer.DefaultLevel]</span>
            }
        </span>
    </span>
    <span class="lineup__moves">
        @foreach (var team in Teams)
        {
            <button @key="team.Side" type="button" class="team-toggle team-toggle--lock team-color--@team.ColorCode"
                    aria-pressed="@(LockedSide == team.Side ? "true" : "false")"
                    aria-label="@L["Suggest_LockLabel", Player.Name, team.Label]"
                    @onclick="() => OnLock.InvokeAsync(team.Side)">
                @team.Side
            </button>
        }
    </span>
</li>

@code {
    [Parameter, EditorRequired] public Player Player { get; set; } = default!;

    /// <summary>Équipe imposée ; null si le joueur est libre.</summary>
    [Parameter] public TeamSide? LockedSide { get; set; }

    [Parameter, EditorRequired] public IReadOnlyList<TeamButton> Teams { get; set; } = [];

    /// <summary>Le verrou d'une équipe a été touché.</summary>
    [Parameter] public EventCallback<TeamSide> OnLock { get; set; }
}
