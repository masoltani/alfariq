@implements IDisposable
@inject ConnectivityService Connectivity
@inject IStringLocalizer<Strings> L

@if (!Connectivity.IsOnline)
{
    <div class="banner banner--offline" role="status">
        @L["Status_Offline"]
    </div>
}

@code {
    protected override void OnInitialized() => Connectivity.Changed += OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Connectivity.Changed -= OnChanged;
}
