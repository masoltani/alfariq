@inherits LayoutComponentBase
@inject ConnectivityService Connectivity
@inject ThemeService Theme
@inject UpdateService Update
@inject AlFariq.Application.IStoragePersistence StoragePersistence

<div class="app-shell">
    <OfflineBanner />
    <UpdatePrompt />

    <main class="app-main" id="main">
        @Body
    </main>

    <BottomNav />
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // L'interopérabilité JavaScript n'est disponible qu'après le premier rendu.
        await Theme.InitializeAsync();
        await Connectivity.InitializeAsync();
        await Update.InitializeAsync();

        // US-002 : demande au navigateur de ne pas effacer les données locales (sans effet s'il ne le propose pas).
        await StoragePersistence.RequestAsync();
    }
}
