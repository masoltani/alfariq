+@inject IStringLocalizer<Strings> L
+
+@* Les chiffres d'un joueur sur la période (US-014, RG-STA-02). *@
+<dl class="stats-grid">
+    <div>
+        <dt>@L["Stats_Played"]</dt>
+        <dd>@Totals.Played</dd>
+    </div>
+    <div>
+        <dt>@L["Stats_Wins"]</dt>
+        <dd>@Totals.Wins</dd>
+    </div>
+    <div>
+        <dt>@L["Stats_Draws"]</dt>
+        <dd>@Totals.Draws</dd>
+    </div>
+    <div>
+        <dt>@L["Stats_Losses"]</dt>
+        <dd>@Totals.Losses</dd>
+    </div>
+    <div>
+        <dt>@L["Stats_Goals"]</dt>
+        <dd>@Totals.Goals</dd>
