@@ -0,0 +1,50 @@
+namespace AlFariq.Domain;
+
+/// <summary>Les périodes proposées pour les statistiques (US-014, RG-STA-05).</summary>
+public enum PeriodKind
+{
+    All,
+    Month,
+    Season,
+    Custom,
+}
+
+/// <summary>Une période en jours, bornes comprises ; une borne absente ne limite rien.</summary>
+public sealed record StatsPeriod(DateOnly? From = null, DateOnly? To = null)
+{
+    /// <summary>La saison va du 1er juillet au 30 juin.</summary>
+    public const int SeasonFirstMonth = 7;
+
+    /// <summary>Vrai si le début suit la fin : aucun jour ne convient.</summary>
+    public bool IsReversed => From > To;
+
+    public bool Contains(DateOnly day) => (From is null || day >= From) && (To is null || day <= To);
+
+    /// <summary>La période d'un choix, vue d'un jour donné.</summary>
+    /// <param name="kind">Le choix.</param>
+    /// <param name="today">Le jour qui situe le mois et la saison en cours.</param>
+    /// <param name="from">Début, pour des dates au choix.</param>
+    /// <param name="to">Fin, pour des dates au choix.</param>
+    public static StatsPeriod Of(PeriodKind kind, DateOnly today, DateOnly? from = null, DateOnly? to = null) =>
+        kind switch
+        {
+            PeriodKind.All => new StatsPeriod(),
+            PeriodKind.Month => MonthOf(today),
+            PeriodKind.Season => SeasonOf(today),
+            PeriodKind.Custom => new StatsPeriod(from, to),
+            _ => throw new ArgumentOutOfRangeException(nameof(kind), kind, "Période inconnue."),
+        };
+
+    private static StatsPeriod MonthOf(DateOnly day)
+    {
+        var first = new DateOnly(day.Year, day.Month, 1);
+        return new StatsPeriod(first, first.AddMonths(1).AddDays(-1));
+    }
+
+    private static StatsPeriod SeasonOf(DateOnly day)
+    {
+        var year = day.Month >= SeasonFirstMonth ? day.Year : day.Year - 1;
+        var first = new DateOnly(year, SeasonFirstMonth, 1);
+        return new StatsPeriod(first, first.AddYears(1).AddDays(-1));
+    }
+}
diff --git a/src/AlFariq.UI/Components/PeriodFilter.razor b/src/AlFariq.UI/Components/PeriodFilter.razor
new file mode 100644
index 0000000..28299a5
--- /dev/null
+++ b/src/AlFariq.UI/Components/PeriodFilter.razor
@@ -0,0 +1,64 @@
+@using System.Globalization
+@inject IStringLocalizer<Strings> L
+@inject StatsFilterState State
+@inject TimeProvider Clock
+
+@* La période des statistiques (US-014) : elle s'applique à tous les chiffres affichés. *@
+<div class="field">
+    <label for="stats-period">@L["Stats_Period"]</label>
+    <select id="stats-period" value="@State.Period.ToString()" @onchange="SetPeriodAsync">
+        <option value="All">@L["Stats_PeriodAll"]</option>
+        <option value="Month">@L["Stats_PeriodMonth"]</option>
+        <option value="Season">@L["Stats_PeriodSeason"]</option>
+        <option value="Custom">@L["Stats_PeriodCustom"]</option>
+    </select>
+</div>
+
+@if (State.Period == PeriodKind.Custom)
+{
+    <div class="period-dates">
+        <div class="field">
+            <label for="stats-from">@L["Stats_From"]</label>
+            <input id="stats-from" type="date" value="@DateInput.Value(State.From)" @onchange="SetFromAsync" />
+        </div>
+        <div class="field">
+            <label for="stats-to">@L["Stats_To"]</label>
+            <input id="stats-to" type="date" value="@DateInput.Value(State.To)" @onchange="SetToAsync" />
+        </div>
+    </div>
+    if (new StatsPeriod(State.From, State.To).IsReversed)
+    {
+        <p class="field__warning" role="alert">@L["Stats_PeriodReversed"]</p>
+    }
+}
+else if (State.Period != PeriodKind.All)
+{
+    var period = State.PeriodAt(
+        DateOnly.FromDateTime(MatchSchedule.ToLocal(Clock.GetUtcNow(), Clock.LocalTimeZone)));
+    <p class="hint">@L["Stats_PeriodRange", Day(period.From), Day(period.To)]</p>
+}
+
+@code {
+    /// <summary>La période a changé : l'écran recalcule ses chiffres.</summary>
+    [Parameter] public EventCallback OnChanged { get; set; }
+
+    private static string Day(DateOnly? date) => date?.ToString("d MMMM yyyy", CultureInfo.CurrentUICulture) ?? "";
+
+    private Task SetPeriodAsync(ChangeEventArgs e)
+    {
+        State.Period = Enum.TryParse<PeriodKind>(e.Value as string, out var kind) ? kind : PeriodKind.All;
+        return OnChanged.InvokeAsync();
+    }
+
+    private Task SetFromAsync(ChangeEventArgs e)
+    {
+        State.From = DateInput.Parse(e.Value);
+        return OnChanged.InvokeAsync();
+    }
+
+    private Task SetToAsync(ChangeEventArgs e)
+    {
+        State.To = DateInput.Parse(e.Value);
+        return OnChanged.InvokeAsync();
+    }
+}
