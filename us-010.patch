 }
 
+/* ---------- Terrain ---------- */
+
+.pitch-teams {
+  margin-top: var(--gutter);
+}
+
+/* La pastille à la couleur de l'équipe accompagne son nom. */
+.segmented.pitch-teams .segmented__option span {
+  gap: 0.5rem;
+  overflow-wrap: anywhere;
+  text-align: center;
+}
+
+.pitch-teams .segmented__option span::before {
+  content: "";
+  flex: none;
+  width: 0.875rem;
+  height: 0.875rem;
+  border: 1px solid #ffffff;
+  border-radius: 50%;
+  background: var(--team-color);
+  box-shadow: 0 0 0 1px #55645c;
+}
+
+.pitch-formations {
+  margin-top: var(--gutter);
+}
+
+.pitch {
+  position: relative;
+  isolation: isolate;
+  display: flex;
+  flex-direction: column;
+  justify-content: space-around;
+  gap: 0.5rem;
+  max-width: 420px;
+  min-height: 480px;
+  margin: 0 auto;
+  padding: 0.75rem 0.25rem;
+  border: 2px solid #ffffff;
+  border-radius: 10px;
+  background:
+    linear-gradient(rgb(255 255 255 / 45%), rgb(255 255 255 / 45%)) 0 50% / 100% 2px no-repeat,
+    #1f6b3a;
+  box-shadow: 0 0 0 1px var(--color-border);
+}
+
+/* Tracé schématique : ligne médiane, rond central et surfaces de réparation. */
+.pitch::before,
+.pitch::after {
+  content: "";
+  position: absolute;
+  z-index: -1;
+  left: 50%;
+  transform: translateX(-50%);
+  border: 2px solid rgb(255 255 255 / 45%);
+}
+
+.pitch::before {
+  top: 50%;
+  width: 28%;
+  aspect-ratio: 1;
+  border-radius: 50%;
+  transform: translate(-50%, -50%);
+}
+
+.pitch::after {
+  bottom: 0;
+  width: 56%;
+  height: 14%;
+  border-bottom: 0;
+}
+
+.pitch__line {
+  display: flex;
+  justify-content: space-evenly;
+  align-items: flex-start;
+}
+
+.pitch__slot {
+  display: flex;
+  flex: 1 1 0;
+  flex-direction: column;
+  align-items: center;
+  gap: 0.25rem;
+  min-width: 0;
+  max-width: 5.5rem;
+  min-height: 44px;
+  padding: 0.125rem;
+  border: 0;
+  border-radius: 10px;
+  background: transparent;
+  color: #ffffff;
+  font: inherit;
+  cursor: pointer;
+}
+
+.pitch__slot:focus-visible {
+  outline-color: #ffffff;
+}
+
+.pitch__marker {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  width: 44px;
+  height: 44px;
+  border: 2px solid #ffffff;
+  border-radius: 50%;
+  background: var(--team-color);
+  color: var(--team-ink);
+  font-size: 0.8125rem;
+  font-weight: 700;
+}
+
+.pitch__slot--free .pitch__marker {
+  border-style: dashed;
+  background: rgb(0 0 0 / 25%);
+  color: #ffffff;
+}
+
+/* Deux lignes au plus ; le nom complet reste lu par les lecteurs d'écran (aria-label du bouton). */
+.pitch__name {
+  display: -webkit-box;
+  max-width: 100%;
+  padding: 0 0.25rem;
+  overflow: hidden;
+  border-radius: 6px;
+  background: var(--color-surface);
+  color: var(--color-text);
+  font-size: 0.75rem;
+  font-weight: 600;
+  line-height: 1.3;
+  overflow-wrap: anywhere;
+  text-align: center;
+  -webkit-box-orient: vertical;
+  -webkit-line-clamp: 2;
+}
+
+.pitch__slot--free .pitch__name {
+  background: transparent;
+  color: #ffffff;
+  font-size: 1rem;
+}
+
+.pitch-count {
+  margin-top: 0.5rem;
+  text-align: center;
+}
+
+.card.pitch-bench {
+  padding-block: 0.5rem;
+}
+
+.pitch-position label {
+  flex: 1;
+  min-width: 0;
+}
+
+.pitch-position select {
+  width: 55%;
+  min-height: 44px;
+  padding: 0 0.5rem;
+  border: 1px solid var(--color-muted);
+  border-radius: 10px;
+  background: var(--color-surface);
+  color: var(--color-text);
+  font: inherit;
+}
+
+.picker__title {
+  margin-top: var(--gutter);
+}
+
+.picker__title:focus {
+  outline: none;
+}
+
+.picker__group {
+  margin: var(--gutter) 0 0;
+  font-size: 1rem;
+}
+
+.picker__player {
+  display: flex;
+  flex-direction: column;
+  align-items: flex-start;
+  justify-content: center;
+  width: 100%;
+  min-height: 52px;
+  padding: 0.5rem 0;
+  border: 0;
+  background: transparent;
+  color: inherit;
+  font: inherit;
+  text-align: start;
+  cursor: pointer;
+}
+
+.picker__detail {
+  color: var(--color-muted);
+  font-size: 0.875rem;
+}
+
 /* ---------- Bandeaux ---------- */
 
 .banner {
diff --git a/tests/AlFariq.Client.Core.Tests/PitchTests.cs b/tests/AlFariq.Client.Core.Tests/PitchTests.cs
new file mode 100644
index 0000000..c51177b
--- /dev/null
+++ b/tests/AlFariq.Client.Core.Tests/PitchTests.cs
@@ -0,0 +1,251 @@
+using AlFariq.Application;
+using AlFariq.Domain;
+using Microsoft.Extensions.DependencyInjection;
+
+namespace AlFariq.Client.Core.Tests;
+
+/// <summary>Placement sur le terrain et postes (US-010).</summary>
+public sealed class PitchTests : IDisposable
+{
+    private static readonly MatchInput Evening = new(new DateOnly(2026, 12, 2), new TimeOnly(20, 0), 5);
+
+    private readonly FakeClock _clock = new();
+    private readonly ServiceProvider _app;
+    private readonly LineupService _lineups;
+
+    public PitchTests()
+    {
+        _app = MatchTestHost.Create(_clock);
+        _lineups = _app.GetRequiredService<LineupService>();
+    }
+
+    public void Dispose() => _app.Dispose();
+
+    private MatchService Matches => _app.GetRequiredService<MatchService>();
+
+    private SquadService Squads => _app.GetRequiredService<SquadService>();
+
+    private async Task<Guid> NewMatchAsync() => (await Matches.CreateAsync(Evening)).Id;
+
+    private async Task<Guid> JoinAsync(Guid match, string name, TeamSide? side = TeamSide.A)
+    {
+        var player = (await Squads.AddNewPlayerAsync(match, name)).Id;
+        await _lineups.AssignAsync(match, player, side);
+        return player;
+    }
+
+    private async Task<TeamLineup> TeamAAsync(Guid match) => (await _lineups.GetAsync(match))!.TeamA;
+
+    // Chaque écriture a sa propre date, comme sur un appareil.
+    private async Task PlaceAsync(Guid match, int slot, Guid? player)
+    {
+        _clock.Advance(TimeSpan.FromSeconds(1));
+        await _lineups.PlaceAsync(match, TeamSide.A, slot, player);
+    }
+
+    private async Task<Guid> MatchWithFormationAsync()
+    {
+        var match = await NewMatchAsync();
+        await _lineups.SetFormationAsync(match, TeamSide.A, "2-1-1");
+        return match;
+    }
+
+    [Fact]
+    public async Task A_lineup_without_formation_or_positions_is_valid()
+    {
+        var match = await NewMatchAsync();
+        await JoinAsync(match, "Sami");
+
+        var team = await TeamAAsync(match);
+
+        Assert.Null(team.Formation);
+        Assert.Empty(team.OnPitch);
+        Assert.Empty(team.Positions);
+        Assert.Single(team.OffPitch);
+    }
+
+    [Fact]
+    public async Task A_placed_player_takes_the_position_of_the_spot()
+    {
+        var match = await MatchWithFormationAsync();
+        var sami = await JoinAsync(match, "Sami");
+
+        await PlaceAsync(match, 0, sami);
+
+        var team = await TeamAAsync(match);
+        Assert.Equal(sami, team.OnPitch[0].Id);
+        Assert.Equal("football.goalkeeper", team.Positions[sami]);
+        Assert.Empty(team.OffPitch);
+    }
+
+    [Fact]
+    public async Task A_player_from_the_bench_replaces_the_occupant()
+    {
+        var match = await MatchWithFormationAsync();
+        var sami = await JoinAsync(match, "Sami");
+        var alice = await JoinAsync(match, "Alice");
+        await PlaceAsync(match, 3, sami);
+
+        await PlaceAsync(match, 3, alice);
+
+        var team = await TeamAAsync(match);
+        Assert.Equal(alice, team.OnPitch[3].Id);
+        Assert.Equal(new[] { sami }, team.OffPitch.Select(player => player.Id));
+        Assert.False(team.Positions.ContainsKey(sami));
+    }
+
+    [Fact]
+    public async Task Two_players_on_the_pitch_swap_their_spots()
+    {
+        var match = await MatchWithFormationAsync();
+        var sami = await JoinAsync(match, "Sami");
+        var alice = await JoinAsync(match, "Alice");
+        await PlaceAsync(match, 0, sami);
+        await PlaceAsync(match, 4, alice);
+
+        await PlaceAsync(match, 0, alice);
+
+        var team = await TeamAAsync(match);
+        Assert.Equal(alice, team.OnPitch[0].Id);
+        Assert.Equal(sami, team.OnPitch[4].Id);
+        Assert.Equal("football.forward", team.Positions[sami]);
+    }
+
+    [Fact]
+    public async Task A_spot_can_be_emptied()
+    {
+        var match = await MatchWithFormationAsync();
+        var sami = await JoinAsync(match, "Sami");
+        await PlaceAsync(match, 1, sami);
+
+        await PlaceAsync(match, 1, null);
+
+        var team = await TeamAAsync(match);
+        Assert.Empty(team.OnPitch);
+        Assert.Empty(team.Positions);
+    }
+
+    [Fact]
+    public async Task An_unassigned_player_joins_the_team_when_placed()
+    {
+        var match = await MatchWithFormationAsync();
+        var sami = await JoinAsync(match, "Sami", side: null);
+
+        await PlaceAsync(match, 2, sami);
+
+        Assert.Equal(sami, (await TeamAAsync(match)).OnPitch[2].Id);
+    }
+
+    [Fact]
+    public async Task Invalid_placements_are_rejected()
+    {
+        var match = await NewMatchAsync();
+        var opponent = await JoinAsync(match, "Zoé", TeamSide.B);
+
+        await Assert.ThrowsAsync<InvalidOperationException>(() => PlaceAsync(match, 0, null));
+
+        await _lineups.SetFormationAsync(match, TeamSide.A, "2-1-1");
+
+        await Assert.ThrowsAsync<InvalidOperationException>(() => PlaceAsync(match, 0, opponent));
+        await Assert.ThrowsAsync<InvalidOperationException>(() => PlaceAsync(match, 0, Guid.CreateVersion7()));
+        await Assert.ThrowsAsync<ArgumentOutOfRangeException>(() => PlaceAsync(match, 5, null));
+        await Assert.ThrowsAsync<ArgumentException>(
+            () => _lineups.SetFormationAsync(match, TeamSide.A, "4-4-2"));
+    }
+
+    [Fact]
+    public async Task Changing_team_frees_the_spot()
+    {
+        var match = await MatchWithFormationAsync();
+        var sami = await JoinAsync(match, "Sami");
+        await PlaceAsync(match, 0, sami);
+
+        await _lineups.AssignAsync(match, sami, TeamSide.B);
+        await _lineups.AssignAsync(match, sami, TeamSide.A);
+
+        Assert.Empty((await TeamAAsync(match)).OnPitch);
+    }
+
+    [Fact]
+    public async Task Changing_formation_keeps_the_players_on_the_pitch()
+    {
+        var match = await MatchWithFormationAsync();
+        var sami = await JoinAsync(match, "Sami");
+        var alice = await JoinAsync(match, "Alice");
+        await PlaceAsync(match, 0, sami);
+        await PlaceAsync(match, 4, alice);
+
+        await _lineups.SetFormationAsync(match, TeamSide.A, "1-2-1");
+
+        var team = await TeamAAsync(match);
+        Assert.Equal("football.goalkeeper", team.Positions[sami]);
+        Assert.Equal("football.forward", team.Positions[alice]);
+        Assert.Equal(2, team.OnPitch.Count);
+    }
+
+    [Fact]
+    public async Task Removing_the_formation_keeps_the_positions()
+    {
+        var match = await MatchWithFormationAsync();
+        var sami = await JoinAsync(match, "Sami");
+        await PlaceAsync(match, 0, sami);
+
+        await _lineups.SetFormationAsync(match, TeamSide.A, null);
+
+        var team = await TeamAAsync(match);
+        Assert.Empty(team.OnPitch);
+        Assert.Equal("football.goalkeeper", team.Positions[sami]);
+    }
+
+    [Fact]
+    public async Task A_position_can_be_given_without_formation_only()
+    {
+        var match = await NewMatchAsync();
+        var sami = await JoinAsync(match, "Sami");
+
+        await _lineups.SetPositionAsync(match, sami, "football.striker");
+
+        Assert.Equal("football.striker", (await TeamAAsync(match)).Positions[sami]);
+        await Assert.ThrowsAsync<ArgumentException>(
+            () => _lineups.SetPositionAsync(match, sami, "handball.pivot"));
+
+        await _lineups.SetPositionAsync(match, sami, null);
+
+        Assert.Empty((await TeamAAsync(match)).Positions);
+
+        await _lineups.SetFormationAsync(match, TeamSide.A, "2-1-1");
+
+        await Assert.ThrowsAsync<InvalidOperationException>(
+            () => _lineups.SetPositionAsync(match, sami, "football.striker"));
+    }
+
+    [Fact]
+    public async Task A_formation_keeps_the_team_name_and_colour()
+    {
+        var match = await NewMatchAsync();
+        await _lineups.SetTeamAsync(match, TeamSide.A, "Les Verts", "green");
+
+        await _lineups.SetFormationAsync(match, TeamSide.A, "2-1-1");
+        await _lineups.SetTeamAsync(match, TeamSide.A, "Les Verts", "black");
+
+        var team = await TeamAAsync(match);
+        Assert.Equal("Les Verts", team.Name);
+        Assert.Equal("black", team.ColorCode);
+        Assert.Equal("2-1-1", team.Formation?.Code);
+    }
+
+    [Fact]
+    public async Task A_formation_no_longer_applies_when_the_format_changes()
+    {
+        var match = await MatchWithFormationAsync();
+        var sami = await JoinAsync(match, "Sami");
+        await PlaceAsync(match, 0, sami);
+
+        await Matches.UpdateAsync(match, Evening with { PlayersPerSide = 7 });
+
+        var team = await TeamAAsync(match);
+        Assert.Null(team.Formation);
+        Assert.Empty(team.OnPitch);
+        Assert.Equal(new[] { sami }, team.Players.Select(player => player.Id));
+    }
+}
diff --git a/tests/AlFariq.Domain.Tests/FormationTests.cs b/tests/AlFariq.Domain.Tests/FormationTests.cs
new file mode 100644
index 0000000..f2249ed
--- /dev/null
+++ b/tests/AlFariq.Domain.Tests/FormationTests.cs
@@ -0,0 +1,107 @@
+using AlFariq.Domain;
+
+namespace AlFariq.Domain.Tests;
+
+public class FormationTests
+{
+    private const string Keeper = "football.goalkeeper";
+
+    private static Formation Get(int playersPerSide, string code) =>
+        FormationCatalog.Find("football", playersPerSide, code)!;
+
+    private static string[] PositionsOf(Formation formation, IReadOnlyDictionary<Guid, int> placed, params Guid[] players) =>
+        players.Select(player => formation.Slots[placed[player]].PositionCode).ToArray();
+
+    [Theory]
+    [InlineData(5)]
+    [InlineData(7)]
+    [InlineData(11)]
+    public void Every_football_format_has_formations_of_the_right_size(int format)
+    {
+        var formations = FormationCatalog.For("football", format);
+
+        Assert.NotEmpty(formations);
+        Assert.Equal(formations.Count, formations.Select(formation => formation.Code).Distinct().Count());
+        Assert.All(formations, formation =>
+        {
+            Assert.Equal(format, formation.PlayersPerSide);
+            Assert.Equal(Enumerable.Range(0, format), formation.Slots.Select(slot => slot.Index));
+            Assert.All(formation.Slots, slot => Assert.True(SportCatalog.Default.HasPosition(slot.PositionCode)));
+            Assert.True(formation.Slots.Count(slot => slot.PositionCode == Keeper) <= 1);
+        });
+    }
+
+    [Fact]
+    public void The_formations_of_the_user_story_are_provided()
+    {
+        Assert.True(Get(11, "4-4-2").HasGoalkeeper);
+        Assert.False(Get(5, "2-2-1").HasGoalkeeper);
+    }
+
+    [Fact]
+    public void There_is_no_formation_for_another_sport_or_a_free_format()
+    {
+        Assert.Empty(FormationCatalog.For("futsal", 5));
+        Assert.Empty(FormationCatalog.For("football", 6));
+        Assert.Null(FormationCatalog.Find("football", 5, "4-4-2"));
+        Assert.Null(FormationCatalog.Find("football", 5, null));
+    }
+
+    [Fact]
+    public void Every_variant_belongs_to_a_general_position()
+    {
+        var positions = SportCatalog.Default.PositionCodes;
+
+        Assert.All(positions, position => Assert.Contains(SportCatalog.BaseOf(position), positions));
+        Assert.Equal(
+            new[] { "football.goalkeeper", "football.defender", "football.midfielder", "football.forward" },
+            positions.Select(SportCatalog.BaseOf).Distinct());
+    }
+
+    [Fact]
+    public void A_variant_counts_as_its_general_position_for_balancing()
+    {
+        var player = new Player { Name = "Sami", PreferredPositionCode = "football.left_back" };
+
+        Assert.Equal("football.defender", BalancePlayer.From(player, SportCatalog.Default).PositionCode);
+    }
+
+    [Fact]
+    public void Players_go_to_their_exact_position_before_a_close_one()
+    {
+        var formation = Get(11, "4-4-2");
+        var defender = Guid.CreateVersion7();
+        var leftBack = Guid.CreateVersion7();
+
+        var placed = formation.Distribute(
+        [
+            new SlotCandidate(defender, "football.defender", WasOnPitch: false),
+            new SlotCandidate(leftBack, "football.left_back", WasOnPitch: false),
+        ]);
+
+        var positions = PositionsOf(formation, placed, leftBack, defender);
+        Assert.Equal("football.left_back", positions[0]);
+        Assert.Equal("football.defender", SportCatalog.BaseOf(positions[1]));
+    }
+
+    [Fact]
+    public void Nobody_becomes_goalkeeper_automatically()
+    {
+        var formation = Get(5, "2-1-1");
+        var midfielders = Enumerable.Range(0, 5).Select(_ => Guid.CreateVersion7()).ToList();
+
+        var placed = formation.Distribute(
+            midfielders.Select(id => new SlotCandidate(id, "football.midfielder", WasOnPitch: true)).ToList());
+
+        Assert.Equal(4, placed.Count);
+        Assert.DoesNotContain(0, placed.Values);
+    }
+
+    [Fact]
+    public void A_player_without_position_who_was_not_on_the_pitch_stays_off()
+    {
+        var placed = Get(5, "2-1-1").Distribute([new SlotCandidate(Guid.CreateVersion7(), null, WasOnPitch: false)]);
+
+        Assert.Empty(placed);
+    }
+}
